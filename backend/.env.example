# ==========================================
# STUDENT 360 - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Settings
APP_NAME="Student 360 API"
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://vignesh-svk24.github.io"]

# Database Configuration
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/student360
# For local dev / test SQLite fallback:
DATABASE_URL=sqlite:///./student360.db

# File Storage Configuration (prepared for future S3/Supabase/Cloudinary)
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./uploads
STORAGE_BASE_URL=http://localhost:8000/uploads

# Academic Calculation Defaults
MINIMUM_ATTENDANCE_PERCENTAGE=75.0
DEFAULT_PASSING_PERCENTAGE=50.0

# Security & Authentication (JWT + Argon2)
SECRET_KEY=student360-dev-super-secret-key-change-in-production-360
JWT_SECRET_KEY=student360-jwt-secret-key-production-change-360
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
DEFAULT_STUDENT_INITIAL_PASSWORD=Student@360